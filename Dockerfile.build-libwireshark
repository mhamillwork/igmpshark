# Build libwireshark, libwiretap, and libwsutil 4.2.6 on UBI 9.
# The Wireshark GUI, tshark, and the other tools are not built.
#
# UBI 9 has no wireshark package. RHEL 9 AppStream ships 3.4.10, which is
# not the library this tree links. flex, c-ares, and c-ares-devel are
# installed with dnf (scripts/install-flex-c-ares.sh). gnutls-devel,
# speexdsp-devel, and libmaxminddb-devel are not in the UBI repos. SpeexDSP
# is only required for the GUI and sharkd, which this build turns off.
# GnuTLS and MaxMindDB are optional and stay disabled.
#
#   docker build -f Dockerfile.build-libwireshark -t igmpshark-libwireshark:ubi9 .
#
# Libraries land in /opt/wireshark-4.2.6/build/run/.

FROM registry.access.redhat.com/ubi9/ubi:9.8

# curl-minimal is already installed and conflicts with the curl package.
RUN dnf -y install \
        gcc gcc-c++ make cmake ninja-build pkgconf-pkg-config python3 \
        m4 file \
        glib2-devel libgcrypt-devel libgpg-error-devel libpcap-devel pcre2-devel \
        zlib-devel libxml2-devel lz4-devel libzstd-devel \
        libnghttp2-devel brotli-devel krb5-devel libssh-devel libcurl-devel \
        xz tar gzip ca-certificates diffutils findutils \
    && dnf clean all

COPY scripts/install-flex-c-ares.sh /tmp/install-flex-c-ares.sh
RUN chmod +x /tmp/install-flex-c-ares.sh && /tmp/install-flex-c-ares.sh

COPY scripts/build-wireshark-4.2.6.sh /tmp/build-wireshark-4.2.6.sh
RUN chmod +x /tmp/build-wireshark-4.2.6.sh \
    && NATIVE=0 /tmp/build-wireshark-4.2.6.sh /opt/wireshark-4.2.6 \
    && test -e /opt/wireshark-4.2.6/build/run/libwireshark.so \
    && test -e /opt/wireshark-4.2.6/build/run/libwiretap.so \
    && test -e /opt/wireshark-4.2.6/build/run/libwsutil.so \
    && ldd /opt/wireshark-4.2.6/build/run/libwireshark.so \
    && grep -a -q '4.2.6' /opt/wireshark-4.2.6/build/run/libwireshark.so /opt/wireshark-4.2.6/build/run/libwsutil.so

WORKDIR /opt/wireshark-4.2.6/build/run
