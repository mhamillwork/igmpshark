# Build libwireshark, libwiretap, and libwsutil 4.2.6 on UBI 9.
# The Wireshark GUI, tshark, and the other tools are not built.
#
# UBI 9 (RHEL 9.8) has no wireshark package. Its AppStream Wireshark, on a
# subscribed host, is 3.4.10, which is not the library this tree links.
# flex and c-ares-devel are also absent from the UBI repos, and Wireshark's
# CMake setup requires both, so those two are built from upstream tarballs.
# gnutls-devel, speexdsp-devel, and libmaxminddb-devel are absent too.
# SpeexDSP is only required for the GUI and sharkd, which this build turns
# off. GnuTLS and MaxMindDB are optional and stay disabled.
#
#   docker build -f Dockerfile.build-libwireshark -t igmpshark-libwireshark:ubi9 .
#
# Libraries land in /opt/wireshark-4.2.6/build/run/.

FROM registry.access.redhat.com/ubi9/ubi:9.8

# curl-minimal is already installed and conflicts with the curl package.
RUN dnf -y install \
        gcc gcc-c++ make cmake ninja-build pkgconf-pkg-config python3 \
        m4 file \
        glib2-devel libgcrypt-devel libgpg-error-devel libpcap-devel pcre2-devel \
        zlib-devel libxml2-devel lz4-devel libzstd-devel \
        libnghttp2-devel brotli-devel krb5-devel libssh-devel libcurl-devel \
        xz tar gzip ca-certificates diffutils findutils \
    && dnf clean all

# flex 2.6.4 is the flex release RHEL 9 packages. c-ares 1.34.5 is above
# Wireshark 4.2.6's minimum of 1.13.
ARG FLEX_VERSION=2.6.4
ARG FLEX_SHA256=e87aae032bf07c26f85ac0ed3250998c37621d95f8bd748b31f15b33c45ee995
ARG CARES_VERSION=1.34.5
ARG CARES_SHA256=7d935790e9af081c25c495fd13c2cfcda4792983418e96358ef6e7320ee06346

RUN curl -fsSL -o /tmp/flex.tar.gz \
        "https://github.com/westes/flex/releases/download/v${FLEX_VERSION}/flex-${FLEX_VERSION}.tar.gz" \
    && echo "${FLEX_SHA256}  /tmp/flex.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/flex.tar.gz -C /tmp \
    && cd "/tmp/flex-${FLEX_VERSION}" \
    && ./configure --prefix=/usr --disable-libfl \
    && make -j"$(nproc)" \
    && make install \
    && rm -rf /tmp/flex.tar.gz "/tmp/flex-${FLEX_VERSION}" \
    && flex --version

RUN curl -fsSL -o /tmp/c-ares.tar.gz \
        "https://github.com/c-ares/c-ares/releases/download/v${CARES_VERSION}/c-ares-${CARES_VERSION}.tar.gz" \
    && echo "${CARES_SHA256}  /tmp/c-ares.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/c-ares.tar.gz -C /tmp \
    && cd "/tmp/c-ares-${CARES_VERSION}" \
    && ./configure --prefix=/usr --libdir=/usr/lib64 --disable-static \
    && make -j"$(nproc)" \
    && make install \
    && ldconfig \
    && rm -rf /tmp/c-ares.tar.gz "/tmp/c-ares-${CARES_VERSION}" \
    && test -f /usr/include/ares.h \
    && test -e /usr/lib64/libcares.so

COPY scripts/build-wireshark-4.2.6.sh /tmp/build-wireshark-4.2.6.sh
RUN chmod +x /tmp/build-wireshark-4.2.6.sh \
    && NATIVE=0 /tmp/build-wireshark-4.2.6.sh /opt/wireshark-4.2.6 \
    && test -e /opt/wireshark-4.2.6/build/run/libwireshark.so \
    && test -e /opt/wireshark-4.2.6/build/run/libwiretap.so \
    && test -e /opt/wireshark-4.2.6/build/run/libwsutil.so \
    && ldd /opt/wireshark-4.2.6/build/run/libwireshark.so \
    && grep -a -q '4.2.6' /opt/wireshark-4.2.6/build/run/libwireshark.so /opt/wireshark-4.2.6/build/run/libwsutil.so

WORKDIR /opt/wireshark-4.2.6/build/run
